	)
	(text "5 V rail (spec 3.2). LMR33630B (1.4 MHz, 36 V in, 3 A) makes 5.3 V from V_INPUT.\nPriority by Schottky OR: buck (5.3 V - diode) wins over USB VBUS (5.0 V - diode) whenever the barrel is present;\nthe VBUS diode means the board never back-feeds a USB host. +5V is ~4.85 V on barrel, ~4.55 V on USB only."
		(exclude_from_sim no)
		(at 15.24 15.24 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "d28dd68b-f2a7-4dbe-bbc6-63e7451e4ea8")
	)
