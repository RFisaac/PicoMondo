"""PicoMondo LED test: 3.3V -> resistor -> LED -> GND."""

#pragma experiment("BRIDGE_CONNECT")

import ElectricPower
import LED
import Resistor

module App:
    """
    Simple LED indicator to validate the toolchain.

    ## Requirements
    - R1: 3.3V supply
    - R2: LED current 1mA to 10mA, set by series resistor
    """

    power = new ElectricPower
    assert power.voltage within 3.3V +/- 5%

    led = new LED

    resistor = new Resistor
    resistor.package = "0402"

    # Typical red/green indicator LED
    assert led.diode.forward_voltage within 1.8V to 2.4V
    assert led.diode.max_current within 20mA to 30mA

    # 330R: worst case (3.465V - 1.8V) / 313.5R = 5.3mA, best case 2.1mA
    resistor.resistance = 330ohm +/- 5%

    led_current: A
    assert led_current is (power.voltage - led.diode.forward_voltage) / resistor.resistance
    assert led_current >= 1mA
    assert led_current <= 10mA
    assert led_current <= led.diode.max_current

    power.hv ~> resistor ~> led ~> power.lv
