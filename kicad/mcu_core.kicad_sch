	(text "BOOTSEL: hold while resetting to enter the USB bootloader (QSPI_SS pulled low via 1k).\nRESET: pulls RUN low."
		(exclude_from_sim no)
		(at 50.8 337.82 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "103a9884-6bed-4daf-a659-7bd8d993e28a")
	)
	(text "12 MHz CRYSTAL: Abracon ABM8-272-T3 (10 pF load) with 15 pF caps and 1k series resistor.\nTraces short; ground under the crystal; keep other signals out."
		(exclude_from_sim no)
		(at 50.8 172.72 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "43ed881f-041a-4cc1-9887-32ec28ca008e")
	)
	(text "ON-CHIP REGULATOR (copy the Pi reference layout exactly)\nL1: Abracon AOTA-B201610S3R3-101-T, polarity dot toward VREG_LX.\nKeep L1, C6, C7, R3, C9 within 10 mm of U1; VREG_LX short and wide, no vias.\nR3 must be close to U1."
		(exclude_from_sim no)
		(at 38.1 45.72 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "6ba86ca5-8c9b-4a0a-8139-3c159836b715")
	)
	(text "Optional second memory (not fitted): populate with R-link GPIO0->FLASH2_SS, its pull-up and decoupling.\nUses GPIO0 as chip select, so GPIO0 is then unavailable on the EdgeLock/Arduino connectors."
		(exclude_from_sim no)
		(at 50.546 383.54 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "c03eaede-beab-4159-8956-8cbef41a4fa0")
	)
	(text "QSPI FLASH: W25Q128JVS, 16 MB (RP2350 addresses at most 16 MB per chip select).\nKeep QSPI traces short; place R1, R6, R9, R10 close to the flash."
		(exclude_from_sim no)
		(at 50.8 248.92 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "c90291c3-d288-4644-a132-20c1defcb454")
	)
	(text "DECOUPLING: one 100 nF per supply pin, within 5 mm of the pin; pins 68 and 69 share one.\n4.7 uF on the +1V1 rail sits on the opposite side of the chip from the regulator."
		(exclude_from_sim no)
		(at 38.1 94 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "dbaaafaf-e9e9-4d66-8c8c-48b7aa90f355")
	)
	(text "USB: 27 ohm series resistors close to U1; 90 ohm differential pair, solid ground below.\nUSB_D+ / USB_D- are global nets used by the USB-C connector sheet."
		(exclude_from_sim no)
		(at 342.9 160.02 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left)
		)
		(uuid "ecf7f2f9-008b-4255-8f2b-09fa55a1d40c")
	)
